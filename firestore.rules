rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidPin(pin) {
      return pin.matches('^[0-9]{6}$');
    }

    match /households/{pin} {
      allow read, write: if isValidPin(pin);

      match /items/{itemId} {
        allow read, write: if isValidPin(pin);
      }

      // Tickets: cliente solo lectura; Functions (Admin SDK) escriben
      match /ticketStats/{productKey} {
        allow read: if isValidPin(pin);
        allow write: if false;
      }

      match /gmailConnectionPublic/{docId} {
        allow read: if isValidPin(pin);
        allow write: if false;
      }

      // Tokens OAuth: solo Admin SDK (Cloud Functions)
      match /gmailSecrets/{docId} {
        allow read, write: if false;
      }

      // Idempotencia de import Gmail: solo Admin SDK
      match /importedMessages/{messageId} {
        allow read, write: if false;
      }
    }
  }
}
